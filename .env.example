APP_NAME="Jual Beli Tiket Kapal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jualbelitiketkapal
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Midtrans (ambil dari dashboard.sandbox.midtrans.com > Settings > Access Keys)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_BATAS_BAYAR_MENIT=60

# Akun admin untuk `php artisan db:seed` (password kosong = dibuat acak & ditampilkan sekali)
ADMIN_NAME="Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Produksi: lihat DEPLOY.md
FORCE_HTTPS=false
TRUSTED_PROXIES=
SESSION_SECURE_COOKIE=false
